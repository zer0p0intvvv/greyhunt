  "contact_patterns": {
    "_comment": "用于在正文/评论中识别被混淆的联系方式。先做去混淆归一化再匹配。",
    "wechat": {
      "trigger_words": ["微信", "微", "weixin", "vx", "v信", "v❤", "薇", "威", "徽", "卫", "+v", "加v", "扣我v", "wx", "v:", "v："],
      "id_regex": "[a-zA-Z][-_a-zA-Z0-9]{5,19}"
    },
    "qq": {
      "trigger_words": ["qq", "扣扣", "企鹅", "球球"],
      "id_regex": "[1-9][0-9]{4,11}"
    },
    "telegram": {
      "trigger_words": ["tg", "电报", "飞机", "telegram", "纸飞机"],
      "id_regex": "@?[a-zA-Z][a-zA-Z0-9_]{4,31}"
    },
    "phone": {
      "trigger_words": ["电话", "手机", "号码", "联系"],
      "id_regex": "(?<!\\d)1[3-9]\\d{9}(?!\\d)"
    }
  },

